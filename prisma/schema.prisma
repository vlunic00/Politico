generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Frequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum CoverageStatus {
  AWAITING_VERIFICATION
  ACTIVE
  UNAVAILABLE
}

enum ObservationStatus {
  FINAL
  PROVISIONAL
  REVISED
}

enum IngestionStatus {
  RUNNING
  SUCCEEDED
  NEEDS_REVIEW
  FAILED
}

model Topic {
  id          String                @id
  slug        String                @unique
  nameHr      String
  nameEn      String
  description String
  indicators  IndicatorDefinition[]
}

model DataSource {
  id          String          @id
  name        String
  url         String
  datasets    SourceDataset[]
}

model SourceDataset {
  id                String                @id @default(cuid())
  sourceId          String
  source            DataSource            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalId        String
  url               String
  methodologyUrl    String
  license           String?
  revisions         SourceRevision[]
  indicators        IndicatorDefinition[]
  ingestionRuns     IngestionRun[]

  @@unique([sourceId, externalId])
}

model SourceRevision {
  id                String                 @id @default(cuid())
  sourceDatasetId   String
  sourceDataset     SourceDataset          @relation(fields: [sourceDatasetId], references: [id], onDelete: Restrict)
  contentHash       String
  snapshotPath      String
  retrievedAt       DateTime               @db.Timestamptz(3)
  publicationDate   DateTime?              @db.Date
  sourceUpdatedAt   DateTime?              @db.Timestamptz(3)
  observations      IndicatorObservation[]
  registrations     PartyRegistration[]

  @@unique([sourceDatasetId, contentHash])
}

model Party {
  id            String              @id
  slug          String              @unique
  registrations PartyRegistration[]
  programs      PartyProgram[]
}

model PartyRegistration {
  id             String         @id @default(cuid())
  partyId        String
  party          Party          @relation(fields: [partyId], references: [id], onDelete: Restrict)
  revisionId     String
  revision       SourceRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  name           String
  abbreviation   String?
  status         String
  registerNumber String
  book           Int
  registeredAt   DateTime        @db.Date
  statusDate     DateTime?       @db.Date
  seat           String?
  publishedAt    DateTime        @db.Timestamptz(3)

  @@unique([partyId, revisionId])
  @@index([revisionId])
}

model PartyProgram {
  id       String                   @id @default(cuid())
  partyId  String
  party    Party                    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  context  String
  versions ProgramDocumentVersion[]

  @@unique([partyId, context])
}

model ProgramDocumentVersion {
  id                 String       @id @default(cuid())
  programId          String
  program            PartyProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  version            Int
  title              String
  documentUrl        String
  language           String
  publicationDate    DateTime?     @db.Date
  retrievedAt        DateTime      @db.Timestamptz(3)
  contentHash        String
  revisionHash       String
  storedDocumentPath String
  evidence           Json
  publishedAt        DateTime?     @db.Timestamptz(3)
  reviewedBy         String?
  reviews            ProgramReview[]
  extractions        ProgramExtraction[]
  summaries          ProgramSummary[]

  @@unique([programId, version])
  @@unique([programId, revisionHash])
}

model ProgramReview {
  id        String                 @id @default(cuid())
  versionId String
  version   ProgramDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  reviewer  String
  createdAt DateTime               @default(now()) @db.Timestamptz(3)
}

model ProgramExtraction {
  id             String                 @id @default(cuid())
  versionId      String
  version        ProgramDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  extractor      String
  contentHash    String
  pages          Json
  complete       Boolean
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  summaries      ProgramSummary[]

  @@unique([versionId, extractor, contentHash])
}

model ProgramSummary {
  id              String                 @id @default(cuid())
  versionId       String
  version         ProgramDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  extractionId    String
  extraction      ProgramExtraction      @relation(fields: [extractionId], references: [id], onDelete: Restrict)
  sequence        Int
  generationKey   String?                @unique
  provider        String
  requestedModel  String
  modelIdentifier String
  promptVersion   String
  generatedAt     DateTime               @default(now()) @db.Timestamptz(3)
  generatedJson   Json
  summaryJson     Json
  revision        Int                    @default(1)
  status          SummaryStatus          @default(DRAFT)
  publishedAt     DateTime?              @db.Timestamptz(3)
  reviews         SummaryReview[]

  @@unique([versionId, sequence])
  @@index([versionId, status])
}

enum SummaryStatus {
  DRAFT
  APPROVED
  REJECTED
}

model SummaryReview {
  id          String         @id @default(cuid())
  summaryId   String
  summary     ProgramSummary @relation(fields: [summaryId], references: [id], onDelete: Restrict)
  actorId     String
  role        String
  action      String
  note        String
  beforeJson  Json
  afterJson   Json
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
}

model GeographicArea {
  id           String                 @id
  nameHr       String
  nameEn       String
  level        String
  validFrom    DateTime?              @db.Date
  validTo      DateTime?              @db.Date
  observations IndicatorObservation[]
}

model IndicatorDefinition {
  id                     String                 @id
  slug                   String                 @unique
  topicId                String
  topic                  Topic                  @relation(fields: [topicId], references: [id], onDelete: Restrict)
  nameHr                 String
  nameEn                 String
  definition             String
  unit                   String
  frequency              Frequency
  geographicCoverage     String[]
  sourceDatasetId        String?
  sourceDataset          SourceDataset?         @relation(fields: [sourceDatasetId], references: [id], onDelete: Restrict)
  preferredComparator    String?
  interpretationRule     String?
  limitations            String?
  minimumHistoryPeriods  Int?
  coverageStatus         CoverageStatus         @default(AWAITING_VERIFICATION)
  observations           IndicatorObservation[]
}

model IndicatorObservation {
  id                 String              @id @default(cuid())
  indicatorId        String
  indicator          IndicatorDefinition @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  geographyId        String
  geography          GeographicArea      @relation(fields: [geographyId], references: [id], onDelete: Restrict)
  periodStart        DateTime            @db.Date
  periodEnd          DateTime            @db.Date
  frequency          Frequency
  value              Decimal             @db.Decimal(24, 8)
  unit               String
  publicationDate    DateTime?           @db.Date
  retrievedAt        DateTime            @db.Timestamptz(3)
  observationStatus  ObservationStatus
  sourceFlags        String              @default("")
  revisionId         String
  revision           SourceRevision      @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  methodologyVersion String
  publishedAt        DateTime?           @db.Timestamptz(3)

  @@unique([indicatorId, geographyId, periodStart, periodEnd, revisionId])
  @@index([indicatorId, geographyId, periodStart])
}

model IngestionRun {
  id              String          @id @default(cuid())
  sourceDatasetId String
  sourceDataset   SourceDataset   @relation(fields: [sourceDatasetId], references: [id], onDelete: Restrict)
  status          IngestionStatus @default(RUNNING)
  startedAt       DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt      DateTime?       @db.Timestamptz(3)
  recordsStaged   Int             @default(0)
  recordsPublished Int            @default(0)
  error          String?
}
