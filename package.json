{
  "name": "croatia-political-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:ingestion": "node --env-file=.env node_modules/vitest/vitest.mjs run src/lib/statistics/ingestion.integration.test.ts",
    "test:e2e": "playwright test",
    "test:editorial": "playwright test --config playwright.editorial.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "data:import": "tsx scripts/import-data.ts",
    "data:coverage": "tsx scripts/data-coverage.ts",
    "parties:import": "tsx scripts/import-parties.ts",
    "elections:import": "tsx scripts/import-elections.ts",
    "accountability:archive": "tsx scripts/archive-accountability.ts",
    "parties:program": "tsx scripts/party-program.ts",
    "parties:summary": "tsx scripts/party-summary.ts",
    "editorial:user": "tsx scripts/editorial-user.ts",
    "test:parties": "node --env-file=.env node_modules/vitest/vitest.mjs run src/lib/parties/parties.integration.test.ts",
    "test:elections": "node --env-file=.env node_modules/vitest/vitest.mjs run src/lib/elections/elections.integration.test.ts",
    "test:accountability": "node --env-file=.env node_modules/vitest/vitest.mjs run src/lib/accountability/accountability.integration.test.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
