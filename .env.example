NEXT_PUBLIC_APP_NAME="Croatia Political Observatory"
DATABASE_URL="postgresql://observatory:observatory@localhost:5432/observatory?schema=public"
DATA_SNAPSHOT_DIR=".data/snapshots"
PROGRAM_DOCUMENT_DIR=".data/programs"
# Server-only. Select a model with strict JSON-schema support; never use NEXT_PUBLIC_ for these values.
LLM_BASE_URL="https://api.openai.com/v1/"
LLM_MODEL=""
LLM_API_KEY=""
# Optional full executable paths; otherwise Poppler tools must be on PATH.
PDFTOTEXT_PATH=""
PDFINFO_PATH=""
# Set the exact browser origin; HTTPS is required outside localhost.
EDITORIAL_ORIGIN="http://127.0.0.1:3000"
# Public corrections require this exact browser origin (falls back to EDITORIAL_ORIGIN).
PUBLIC_ORIGIN="http://127.0.0.1:3000"
# JSON array of {id,role,tokenHash}; generate individual credentials with npm run editorial:user.
EDITORIAL_USERS='[]'
